# Copia este archivo a `.env` (en esta misma carpeta) y ajusta los valores.
# Variables propias de este stack. GITLAB_SSH_PORT y EDGE_NETWORK también
# viven en el .env de la raíz del repo (los usan scripts/provision-server.sh
# y scripts/create-network.sh) y deben tener aquí el mismo valor.

# Revisa la última versión estable en
# https://hub.docker.com/r/gitlab/gitlab-ce/tags antes de desplegar en
# producción.
GITLAB_VERSION=17.5.2-ce.0

# Debe coincidir con GITLAB_SSH_PORT del .env de la raíz del repo (que es
# quien abre este puerto en el firewall).
GITLAB_SSH_PORT=2222

# Debe coincidir con EDGE_NETWORK del .env de la raíz del repo.
EDGE_NETWORK=edge

# Dominio base sobre el que se arma el subdominio de GitLab
# (gitlab.<BASE_DOMAIN>) y, más adelante, el de cada ambiente Odoo.
#
# Si todavía no tienes un dominio real (por ejemplo, en un servidor de
# pruebas), usa el truco de nip.io: cualquier-cosa.<IP-DEL-SERVIDOR>.nip.io
# resuelve públicamente a <IP-DEL-SERVIDOR> sin necesidad de DNS propio.
# Ejemplo: BASE_DOMAIN=192.168.1.50.nip.io
BASE_DOMAIN=CAMBIAME.nip.io
