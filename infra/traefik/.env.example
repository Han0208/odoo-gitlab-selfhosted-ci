# Copia este archivo a `.env` (en esta misma carpeta) y ajusta los valores.
# Variables propias de este stack. EDGE_NETWORK también vive en el .env de
# la raíz del repo (lo usa scripts/create-network.sh) y debe tener aquí el
# mismo valor.

# Versión de la imagen de Traefik. Revisa la última estable en
# https://hub.docker.com/_/traefik/tags antes de desplegar en producción.
TRAEFIK_VERSION=v3.2

# Debe coincidir con EDGE_NETWORK del .env de la raíz del repo.
EDGE_NETWORK=edge

# Email para el registro ACME de Let's Encrypt. Solo se usa si levantas
# Traefik con el override docker-compose.https.yml (requiere un dominio
# real, resoluble públicamente, con el puerto 80 accesible desde internet).
ACME_EMAIL=tu-email@ejemplo.com
