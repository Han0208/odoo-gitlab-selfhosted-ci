# Copia este archivo a `.env` y ajusta los valores a tu servidor.
# `.env` nunca se commitea (ver .gitignore); este archivo sí, como plantilla.

# Puerto SSH del HOST que se redirige al contenedor de GitLab para git
# clone/push por SSH. El puerto 22 del host queda reservado para
# administrar el servidor, por eso GitLab usa uno distinto.
GITLAB_SSH_PORT=2222

# --- Red compartida (Traefik) ---

# Red Docker externa que comparten Traefik y todo lo que expone: GitLab y,
# más adelante, cada ambiente Odoo. Se crea una sola vez con
# scripts/create-network.sh antes de levantar cualquier stack.
EDGE_NETWORK=edge

# Versión de la imagen de Traefik. Revisa la última estable en
# https://hub.docker.com/_/traefik/tags antes de desplegar en producción.
TRAEFIK_VERSION=v3.2

# --- Dominio y TLS ---

# Dominio base sobre el que se arman los subdominios de cada servicio
# (gitlab.<BASE_DOMAIN>, y más adelante odoo-<branch>.<BASE_DOMAIN>).
#
# Si todavía no tienes un dominio real (por ejemplo, en un servidor de
# pruebas), usa el truco de nip.io: cualquier-cosa.<IP-DEL-SERVIDOR>.nip.io
# resuelve públicamente a <IP-DEL-SERVIDOR> sin necesidad de DNS propio.
# Ejemplo: BASE_DOMAIN=192.168.1.50.nip.io
BASE_DOMAIN=CAMBIAME.nip.io

# Email para el registro ACME de Let's Encrypt. Solo se usa si levantas
# Traefik con el override infra/traefik/docker-compose.https.yml (requiere
# un dominio real, resoluble públicamente, con el puerto 80 accesible desde
# internet). No aplica mientras uses nip.io u otro dominio no público.
ACME_EMAIL=tu-email@ejemplo.com

# --- GitLab CE ---

# Revisa la última versión estable en
# https://hub.docker.com/r/gitlab/gitlab-ce/tags antes de desplegar en
# producción.
GITLAB_VERSION=17.5.2-ce.0
