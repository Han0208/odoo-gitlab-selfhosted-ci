# Copia este archivo a `.env` y ajusta los valores a tu servidor.
# `.env` nunca se commitea (ver .gitignore); este archivo sí, como plantilla.
#
# Estas son las variables de alcance SERVIDOR: las usan los scripts en
# /scripts (provisioning, creación de red) porque corren antes de que
# exista cualquier stack. La configuración propia de cada stack
# (versión de imagen, dominio, etc.) vive en su propio .env.example junto
# a su docker-compose.yml (ver infra/traefik/.env.example,
# infra/gitlab/.env.example).

# Puerto SSH del HOST que se redirige al contenedor de GitLab para git
# clone/push por SSH. El puerto 22 del host queda reservado para
# administrar el servidor, por eso GitLab usa uno distinto. También debe
# quedar igual en infra/gitlab/.env, que es quien lo usa para el mapeo de
# puertos del contenedor.
GITLAB_SSH_PORT=2222

# Red Docker externa que comparten Traefik y todo lo que expone: GitLab y,
# más adelante, cada ambiente Odoo. Se crea una sola vez con
# scripts/create-network.sh antes de levantar cualquier stack. También debe
# quedar igual en el .env de cada stack que se conecte a ella.
EDGE_NETWORK=edge
